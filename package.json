{
  "name": "bigbatch",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "web:dev": "turbo run dev --filter=@bigbatch/web",
    "mobile:dev": "turbo run dev --filter=@bigbatch/mobile",
    "api:dev": "turbo run dev --filter=@bigbatch/api",
    "db:generate": "turbo run db:generate --filter=@bigbatch/api",
    "db:migrate": "turbo run db:migrate --filter=@bigbatch/api"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
