{
  "name": "@bigbatch/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@bigbatch/shared": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@libsql/client": "^0.15.0",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "argon2": "^0.41.0",
    "drizzle-orm": "^0.39.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0",
    "lucia": "^3.2.0",
    "resend": "^4.0.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@types/zxcvbn": "^4.4.4",
    "drizzle-kit": "^0.31.0",
    "fast-check": "^3.23.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
